{
  "name": "FeatureAddon",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Which firm/CompanySettings this belongs to"
    },
    "feature": {
      "type": "string",
      "enum": [
        "partnership_1065",
        "equity_split_pro"
      ]
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "null = perpetual"
    },
    "amount_paid": {
      "type": "number",
      "description": "0 if free promo"
    },
    "promo_code_used": {
      "type": "string"
    },
    "payment_reference": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "cancelled"
      ],
      "default": "active"
    },
    "activated_by_id": {
      "type": "string",
      "description": "User who activated"
    }
  },
  "required": [
    "tenant_id",
    "feature"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}