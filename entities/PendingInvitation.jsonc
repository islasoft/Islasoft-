{
  "name": "PendingInvitation",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email of the invited person"
    },
    "intended_name": {
      "type": "string",
      "description": "Name specified during invitation"
    },
    "contractor_form": {
      "type": "string",
      "description": "Required contractor form"
    },
    "processed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the name has been applied to the user"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant ID to assign to the invited user upon acceptance"
    },
    "role": {
      "type": "string",
      "description": "Role to assign to the invited user (e.g. admin, user)"
    },
    "team_category": {
      "type": "string",
      "description": "Team category to assign to the invited user"
    }
  },
  "required": [
    "email",
    "intended_name"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}