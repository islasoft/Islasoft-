{
  "name": "EquityLedgerEntry",
  "type": "object",
  "properties": {
    "equity_partnership_id": {
      "type": "string",
      "description": "FK to EquityPartnership"
    },
    "client_id": {
      "type": "string"
    },
    "partner_name": {
      "type": "string"
    },
    "fiscal_year": {
      "type": "number"
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "BEG_CAP",
        "CONTR",
        "CONTR_ADDL",
        "DIST",
        "INC_ORD",
        "INC_1231",
        "LTCG",
        "STCG",
        "SEC179",
        "DEPL",
        "OTH_DED",
        "OTH_INC",
        "OTH_INCR",
        "ADJ"
      ]
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "allocation_rule": {
      "type": "string",
      "enum": [
        "PRO_RATA",
        "FIXED_PCT",
        "PREFERRED_RETURN",
        "DIRECT"
      ],
      "default": "DIRECT"
    },
    "is_locked": {
      "type": "boolean",
      "default": false
    },
    "basis_warning": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "equity_partnership_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "team_category": "cpa"
          }
        },
        {
          "user_condition": {
            "team_category": "senior_staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "team_category": "cpa"
          }
        },
        {
          "user_condition": {
            "team_category": "senior_staff"
          }
        },
        {
          "user_condition": {
            "team_category": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "team_category": "cpa"
          }
        },
        {
          "user_condition": {
            "team_category": "senior_staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "team_category": "cpa"
          }
        },
        {
          "user_condition": {
            "team_category": "senior_staff"
          }
        }
      ]
    }
  }
}