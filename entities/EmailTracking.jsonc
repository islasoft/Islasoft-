{
  "name": "EmailTracking",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Reference to client"
    },
    "client_name": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string",
      "format": "email"
    },
    "subject": {
      "type": "string"
    },
    "email_type": {
      "type": "string",
      "enum": [
        "invoice",
        "engagement_letter",
        "general",
        "document_share"
      ]
    },
    "related_id": {
      "type": "string"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time"
    },
    "sent_by_id": {
      "type": "string"
    },
    "sent_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "delivered",
        "opened",
        "failed"
      ],
      "default": "sent"
    },
    "opened_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "client_id",
    "recipient_email",
    "subject",
    "email_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "$or": [
          {
            "role": "admin"
          },
          {
            "team_category": "cpa"
          },
          {
            "team_category": "senior_staff"
          },
          {
            "team_category": "staff"
          }
        ]
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "team_category": "cpa"
          }
        },
        {
          "user_condition": {
            "team_category": "senior_staff"
          }
        },
        {
          "user_condition": {
            "team_category": "staff"
          }
        },
        {
          "sent_by_id": "{{user.id}}"
        },
        {
          "client_id": {
            "$in": {
              "collection": "Client",
              "field": "id",
              "filter": {
                "manager_id": "{{user.id}}"
              }
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}